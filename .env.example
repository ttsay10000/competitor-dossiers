# Copy to .env and fill in. .env is gitignored; never commit .env.
#
# DATABASE_URL — used by the app and by export-seed.
# - Local: postgresql://user:pass@localhost:5432/competitor_signals (or your local DB).
# - Export to seed from Render's DB (when the app runs on read-only disk): set this to
#   Render's External Database URL (Postgres service → Connect → "External" connection string).
#   Then run:  .venv/bin/python scripts/export_seed_with_env.py
#
DATABASE_URL=
