# Copy to .env and fill in. .env is gitignored; never commit .env.
#
# Run seed (file → DB) uses internal: app and run_seed_with_env use DATABASE_URL_INTERNAL
# if set, else DATABASE_URL. Export to seed (DB → file) uses external: app and
# export_seed_with_env use DATABASE_URL_EXTERNAL if set, else DATABASE_URL.
#
# DATABASE_URL — fallback when INTERNAL/EXTERNAL unset. On Render set this to internal
# so the app works; set INTERNAL and EXTERNAL explicitly so run seed = internal, export = external.
#
# DATABASE_URL_INTERNAL — run seed (file → DB) and all other app DB access.
# - On Render: set to Internal Database URL (Postgres → Connect → Internal).
# - Local run_seed_with_env: leave unset and set DATABASE_URL to external so the script can reach Render.
#
# DATABASE_URL_EXTERNAL — export seed (DB → file) only.
# - Set to Render's External Database URL when exporting from Render's DB (UI or script).
#
DATABASE_URL=
# DATABASE_URL_INTERNAL=
# DATABASE_URL_EXTERNAL=
